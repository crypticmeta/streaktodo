# Public OAuth client identifier from Google Cloud Console. This is not a
# client secret; Android still validates the package name and signing SHA.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS-only reversed OAuth client ID (com.googleusercontent.apps.<id>).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Mixpanel project tokens are public ingest identifiers. Use a separate token
# for staging when possible; never put a Mixpanel service-account secret here.
EXPO_PUBLIC_MIXPANEL_TOKEN=
EXPO_PUBLIC_MIXPANEL_REGION=eu

# Set to 1 for builds that must make analytics a compile-time no-op.
EXPO_PUBLIC_MIXPANEL_DISABLE=0
